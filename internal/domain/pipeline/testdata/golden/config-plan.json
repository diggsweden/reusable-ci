  "containers": {
    "all": [
      {
        "name": "api",
        "from": [
          "api"
        ],
        "artifact_types": [
          "go"
        ],
        "container_file": "Containerfile",
        "context": ".",
        "platforms": "linux/amd64,linux/arm64",
        "enable_analyzed_container_sbom": true,
        "enable_slsa": true,
        "enable_scan": true,
        "build_args": {
          "VERSION": "${VERSION}"
        },
        "build_args_string": "VERSION=${VERSION}",
        "extract_binary_target": "export",
        "extract_binary_names": [
          "api"
        ]
      }
    ],
    "has_containers": true
  },
  "any_require_authorization": true,
  "pipeline_sboms": "build,analyzed-artifact,analyzed-container",
  "fallback_project_type": "maven",
  "sign": {
    "method": "gpg",
    "requires_id_token": false,
    "imports_gpg_key": true,
    "signs_containers": false,
    "requires_sigstore_egress": false
  },
  "git_signing": {
    "method": "gpg"
  }
}
