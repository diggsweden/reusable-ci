{
  "version": 1,
  "context": {
    "project_type": "maven",
    "branch": "feature/demo",
    "release_sha": "abc1234",
    "release_actor": "octocat",
    "release_repository": "org/repo",
    "working_directory": ".",
    "java_version": "",
    "node_version": "",
    "rust_toolchain": "stable",
    "registry": "ghcr.io",
    "reusable_ci_binary_ref": "v3.0.0",
    "npm_registry": "https://npm.pkg.github.com",
    "package_scope": "@org"
  },
  "policy": {
    "publish_npm": true,
    "publish_gradle": false,
    "use_ci_token": true,
    "sboms": "build"
  },
  "stages": {
    "build": {
      "version": 1,
      "stage": "dev-build",
      "targets": {
        "maven": {
          "runs": true,
          "items": [
            {
              "name": "lib",
              "project_type": "maven",
              "working_directory": "services/lib",
              "build_type": "library",
              "publish_to": [
                "maven-central"
              ],
              "sboms": "all",
              "effective_sboms": [
                "build",
                "analyzed-artifact",
                "analyzed-container"
              ],
              "require_authorization": true,
              "build_artifact_name": "lib-build-artifacts",
              "build_sbom_artifact_name": "lib-build-sbom",
              "maven": {
                "java_version": "25",
                "settings_path": "settings.xml"
              }
            }
          ]
        },
        "npm": {
          "runs": true,
          "items": [
            {
              "name": "web",
              "project_type": "npm",
              "working_directory": "apps/web",
              "publish_to": [
                "forge-packages",
                "npmjs"
              ],
              "sboms": "all",
              "effective_sboms": [
                "build",
                "analyzed-artifact",
                "analyzed-container"
              ],
              "build_artifact_name": "web-build-artifacts",
              "build_sbom_artifact_name": "web-build-sbom",
              "npm": {
                "node_version": "24"
              }
            }
          ]
        },
        "gradle": {
          "runs": true,
          "items": [
            {
              "name": "jvm-lib",
              "project_type": "gradle",
              "working_directory": "libs/jvm",
              "build_type": "library",
              "publish_to": [
                "maven-central",
                "forge-packages"
              ],
              "sboms": "all",
              "effective_sboms": [
                "build",
                "analyzed-artifact",
                "analyzed-container"
              ],
              "build_artifact_name": "jvm-lib-build-artifacts",
              "build_sbom_artifact_name": "jvm-lib-build-sbom",
              "publish_tasks": "publishToMavenCentral",
              "gradle": {
                "java_version": "25",
                "publish_tasks": "publishToMavenCentral"
              }
            }
          ]
        },
        "gradle_android": {
          "runs": true,
          "items": [
            {
              "name": "android-lib",
              "project_type": "gradle-android",
              "working_directory": "libs/android",
              "build_type": "library",
              "publish_to": [
                "maven-central"
              ],
              "sboms": "all",
              "effective_sboms": [
                "build",
                "analyzed-artifact",
                "analyzed-container"
              ],
              "build_artifact_name": "android-lib",
              "build_sbom_artifact_name": "android-lib-sbom",
              "android_library": true,
              "needs_android_sdk": true,
              "gradle_android": {
                "java_version": "25",
                "build_module": "lib"
              }
            }
          ]
        },
        "xcode_ios": {
          "runs": false,
          "items": []
        },
        "go": {
          "runs": false,
          "items": []
        },
        "cargo": {
          "runs": false,
          "items": []
        }
      }
    },
    "publish": {
      "version": 1,
      "stage": "dev-publish",
      "inputs": {
        "npm_working_directory": "apps/web",
        "npm_build_artifact_name": "web-build-artifacts",
        "go_sbom_working_directory": "cmd/api",
        "go_sbom_artifact_name": "api",
        "artifact_name": "lib"
      },
      "targets": {
        "npm": {
          "runs": true,
          "items": [
            {
              "name": "web",
              "project_type": "npm",
              "working_directory": "apps/web",
              "publish_to": [
                "forge-packages",
                "npmjs"
              ],
              "sboms": "all",
              "effective_sboms": [
                "build",
                "analyzed-artifact",
                "analyzed-container"
              ],
              "build_artifact_name": "web-build-artifacts",
              "build_sbom_artifact_name": "web-build-sbom",
              "npm": {
                "node_version": "24"
              }
            }
          ]
        },
        "forge_packages_gradle": {
          "runs": false,
          "items": [
            {
              "name": "jvm-lib",
              "project_type": "gradle",
              "working_directory": "libs/jvm",
              "build_type": "library",
              "publish_to": [
                "maven-central",
                "forge-packages"
              ],
              "sboms": "all",
              "effective_sboms": [
                "build",
                "analyzed-artifact",
                "analyzed-container"
              ],
              "build_artifact_name": "jvm-lib-build-artifacts",
              "build_sbom_artifact_name": "jvm-lib-build-sbom",
              "publish_tasks": "publishToMavenCentral",
              "gradle": {
                "java_version": "25",
                "publish_tasks": "publishToMavenCentral"
              }
            }
          ]
        },
        "maven_central_gradle": {
          "runs": false,
          "items": [
            {
              "name": "jvm-lib",
              "project_type": "gradle",
              "working_directory": "libs/jvm",
              "build_type": "library",
              "publish_to": [
                "maven-central",
                "forge-packages"
              ],
              "sboms": "all",
              "effective_sboms": [
                "build",
                "analyzed-artifact",
                "analyzed-container"
              ],
              "build_artifact_name": "jvm-lib-build-artifacts",
              "build_sbom_artifact_name": "jvm-lib-build-sbom",
              "publish_tasks": "publishToMavenCentral",
              "gradle": {
                "java_version": "25",
                "publish_tasks": "publishToMavenCentral"
              }
            },
            {
              "name": "android-lib",
              "project_type": "gradle-android",
              "working_directory": "libs/android",
              "build_type": "library",
              "publish_to": [
                "maven-central"
              ],
              "sboms": "all",
              "effective_sboms": [
                "build",
                "analyzed-artifact",
                "analyzed-container"
              ],
              "build_artifact_name": "android-lib",
              "build_sbom_artifact_name": "android-lib-sbom",
              "android_library": true,
              "needs_android_sdk": true,
              "gradle_android": {
                "java_version": "25",
                "build_module": "lib"
              }
            }
          ]
        },
        "cargo_container_first": {
          "runs": false,
          "items": []
        },
        "go_container_first": {
          "runs": true,
          "items": [
            {
              "name": "api",
              "project_type": "go",
              "working_directory": "cmd/api",
              "sboms": "all",
              "effective_sboms": [
                "build",
                "analyzed-artifact",
                "analyzed-container"
              ],
              "go_build_mode": "container-first",
              "build_sbom_artifact_name": "api-go-build-sbom",
              "go": {
                "build_mode": "container-first"
              }
            }
          ]
        },
        "go_artifact_first": {
          "runs": false,
          "items": []
        },
        "cargo_artifact_first": {
          "runs": false,
          "items": []
        },
        "sbom": {
          "runs": true,
          "items": [
            "dev-sboms"
          ]
        }
      }
    }
  },
  "artifact_transfers": {
    "version": 1,
    "items": [
      {
        "kind": "build_sbom",
        "name": "lib-build-sbom",
        "path": "./release-artifacts/",
        "required": false
      },
      {
        "kind": "build_sbom",
        "name": "web-build-sbom",
        "path": "./release-artifacts/",
        "required": false
      },
      {
        "kind": "build_sbom",
        "name": "jvm-lib-build-sbom",
        "path": "./release-artifacts/",
        "required": false
      },
      {
        "kind": "build_sbom",
        "name": "android-lib-sbom",
        "path": "./release-artifacts/",
        "required": false
      },
      {
        "kind": "build_sbom",
        "name": "api-go-build-sbom",
        "path": "./release-artifacts/",
        "required": false
      }
    ]
  }
}
