{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diggsweden/reusable-ci/docs/schemas/release-images.schema.json",
  "title": "reusable-ci release image ledger",
  "description": "Digest-first ledger handed from build to sign/publish. A bare JSON array of image entries. GENERATED from the Go validator (internal/domain/imageledger) by cmd/gen-release-images-schema — the Go code is the authority; do not hand-edit. additionalProperties is false as editor lint: the Go reader tolerates unknown keys, but a producer emitting one is almost certainly typoing a real field.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["ref", "digest", "final_tag"],
    "properties": {
      "kind": {
        "type": "string",
        "description": "Optional release-manifest metadata: the image role, e.g. distroless, alpine, core."
      },
      "image_kind": {
        "type": "string",
        "enum": [{{IMAGE_KINDS}}],
        "description": "Validation scope of the entry: base is content-addressed, release (the default) is release-scoped. Absent means a legacy entry treated as release."
      },
      "flavor": {
        "type": "string",
        "description": "Optional base-image flavor; empty/absent for single-image releases."
      },
      "ref": {
        "type": "string",
        "pattern": {{IMAGE_REF_PATTERN}},
        "description": "Digest-pinned image reference (registry/path[:tag]@sha256:<64 hex>)."
      },
      "digest": {
        "type": "string",
        "pattern": {{DIGEST_PATTERN}}
      },
      "sbom": {
        "type": "string",
        "pattern": {{SBOM_PATTERN}},
        "description": "Optional relative CycloneDX SBOM path the signer writes/reads (generated by syft if absent)."
      },
      "sbom_sha256": {
        "type": "string",
        "pattern": {{SHA256_HEX_PATTERN}},
        "description": "Optional content pin of a premade SBOM file; requires sbom to name the file it pins."
      },
      "provenance": {
        "type": "object",
        "description": "Optional caller-declared SLSA externalParameters extras; keys must be non-empty, reserved-key collisions are rejected at signing time."
      },
      "final_tag": {
        "type": "string",
        "pattern": {{TAG_REF_PATTERN}},
        "description": "Immutable release tag ref; must be scoped to the release tag (enforced at signing time)."
      },
      "moving_tag": {
        "type": "string",
        "pattern": {{TAG_REF_PATTERN}},
        "description": "Optional moving tag ref (e.g. latest) in final_tag's repository; must not be a staging or release-scoped tag."
      },
      "candidate_tag": {
        "type": "string",
        "pattern": {{TAG_REF_PATTERN}},
        "description": "Optional staging tag ref promoted to final_tag. CONTRACT: the tag name must be exactly staging-<final_tag name>; the signer refuses both promotion and cleanup otherwise."
      },
      "base_ref": {
        "type": "string",
        "description": "Optional digest-pinned base image this image was built from (SLSA lineage)."
      },
      "base_input_id": {
        "type": "string",
        "description": "Optional sha256 identifier of the base-image input set, for SLSA lineage."
      }
    }
  }
}
